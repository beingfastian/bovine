# Large data archives - regenerate with ai/scripts/fetch_*.py
ai/data/*.zip
ai/models/**/*.keras

# Flutter build artifacts (should never have been tracked)
**/build/
**/.dart_tool/
**/.gradle/
**/.idea/
*.iml
flutter_01.log

# Secrets - NEVER commit
**/google-services.json
**/GoogleService-Info.plist
*serviceaccount*.json
*.pem
*.key

# ONNX export. The fp32 artifact and the staging copies are regenerable from
# ai/kernels/bovine-lsd-onnx-export -- see MODEL_CARD.md section 8. The fp16
# model that the web app actually serves is NOT ignored: nothing in the build
# produces it, so leaving it out would deploy a site with no model in it.
ai/data/_upload_model/*.keras
ai/data/_upload_model/*.tflite
ai/kernels/*/out/*.onnx
ai/models/**/*.onnx

# Web app
web/node_modules/
web/.next/
web/out/
web/.env.local
# Regenerated by npm install (postinstall -> scripts/copy-ort-wasm.mjs), so it
# rebuilds on the deploy server and does not belong in the repo.
web/public/ort/

# TypeScript incremental build cache
web/tsconfig.tsbuildinfo
