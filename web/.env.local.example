# Copy to .env.local and fill in from your Supabase project:
#   Dashboard -> Project Settings -> Data API  (URL)
#   Dashboard -> Project Settings -> API Keys  (anon / publishable key)
#
# Both are compiled into the client bundle and are meant to be public. What
# protects the data is the RLS policy in supabase/schema.sql, not these values.
#
# NEVER put the service_role key in this file.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
